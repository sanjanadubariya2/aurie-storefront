# Point this at your Express/Node backend. Leave blank to run on mock data.
VITE_API_URL=http://localhost:4000/api

# Shop contact — used by the "Ask for a quote" buttons
VITE_WHATSAPP=919769469765
VITE_INSTAGRAM=shopaurie.co

# Not actually read by the app — POST /payments/order already returns the
# live key id, so that's the one source of truth and can't drift from
# whatever key the backend is really configured with. Documented here only
# so it's obvious this is the *public* key id, never the secret.
VITE_RAZORPAY_KEY_ID=
